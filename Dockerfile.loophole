FROM debian:bookworm-slim

# 1. Cài đặt các dependencies cần thiết
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    tar \
    && rm -rf /var/lib/apt/lists/*

# 2. Tải và cài đặt Loophole CLI
RUN curl -L https://github.com/loophole/cli/releases/download/1.0.0-beta.15/loophole-cli_1.0.0-beta.15_linux_64bit.tar.gz \
    -o /tmp/loophole.tar.gz && \
    mkdir -p /tmp/loophole && \
    tar -xzf /tmp/loophole.tar.gz -C /tmp/loophole && \
    \
    # Tự động tìm file thực thi và chuyển vào bin
    find /tmp/loophole -type f -executable -exec mv {} /usr/local/bin/loophole \; && \
    chmod +x /usr/local/bin/loophole && \
    \
    # Dọn dẹp
    rm -rf /tmp/loophole /tmp/loophole.tar.gz && \
    \
    # SỬA LẠI DÒNG NÀY: Thêm dấu -- trước version
    loophole --version

# 3. Tạo thư mục cho config
RUN mkdir -p /root/.loophole

# 4. Thiết lập thư mục làm việc
WORKDIR /root

# 5. Lệnh chạy mặc định
ENTRYPOINT ["loophole"]
CMD ["--help"]