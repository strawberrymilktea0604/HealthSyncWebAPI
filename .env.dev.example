# .env.dev.example (Template for Development)
# Copy this file to .env.dev and fill in the actual values

ASPNETCORE_ENVIRONMENT=Development

# Database
SA_PASSWORD=CHANGE_ME
ConnectionStrings__DefaultConnection=Server=db,1433;Database=HealthSyncDb;User Id=sa;Password=CHANGE_ME;Trusted_Connection=False;MultipleActiveResultSets=true;TrustServerCertificate=True
ConnectionStrings__HangfireConnection=Server=db,1433;Database=HealthSyncDb;User Id=sa;Password=CHANGE_ME;Trusted_Connection=False;MultipleActiveResultSets=true;TrustServerCertificate=True
ACCEPT_EULA=Y

# JWT cho Dev
JWT_SECRET_KEY=CHANGE_ME
JwtSettings__SecretKey=CHANGE_ME
JwtSettings__Issuer=HealthSyncAPI
JwtSettings__Audience=HealthSyncClient

# MinIO trong Docker (Dùng tên Service 'minio' thay vì localhost)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MinIO__Endpoint=minio:9000
MinIO__AccessKey=minioadmin
MinIO__SecretKey=minioadmin
MinIO__BucketName=healthsync-images
MinIO__UseSSL=false

# Admin Initialization
ADMIN_INITIALIZATION_KEY=CHANGE_ME

# Google OAuth (Dev)
Authentication__Google__ClientId=CHANGE_ME
Authentication__Google__ClientSecret=CHANGE_ME

# NGINX
NGINX_PORT_HTTP=80

# Ngrok (Get your token from https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=CHANGE_ME