# .env.dev (Docker Development)
# Template for development environment
# Copy this file to .env.dev and fill in the actual values

ASPNETCORE_ENVIRONMENT=Development

# Database
SA_PASSWORD=your-dev-sa-password
ConnectionStrings__DefaultConnection=Server=db,1433;Database=HealthSyncDb;User Id=sa;Password=your-dev-sa-password;Trusted_Connection=False;MultipleActiveResultSets=true;TrustServerCertificate=True
ConnectionStrings__HangfireConnection=Server=db,1433;Database=HealthSyncDb;User Id=sa;Password=your-dev-sa-password;Trusted_Connection=False;MultipleActiveResultSets=true;TrustServerCertificate=True
ACCEPT_EULA=Y

# JWT cho Dev
JWT_SECRET_KEY=your-dev-jwt-secret-key-minimum-32-characters
JwtSettings__SecretKey=your-dev-jwt-secret-key-minimum-32-characters
JwtSettings__Issuer=HealthSyncAPI
JwtSettings__Audience=HealthSyncClient

# MinIO trong Docker (Dùng tên Service 'minio' thay vì localhost)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MinIO__Endpoint=minio:9000
MinIO__AccessKey=minioadmin
MinIO__SecretKey=minioadmin
MinIO__BucketName=healthsync-images
MinIO__UseSSL=false

# Admin Initialization
ADMIN_INITIALIZATION_KEY=your-dev-admin-key

# Google OAuth (Dev)
Authentication__Google__ClientId=your-dev-google-client-id
Authentication__Google__ClientSecret=your-dev-google-client-secret

# NGINX
NGINX_PORT_HTTP=80

# SonarQube với PostgreSQL
SONARQUBE_JDBC_URL=jdbc:postgresql://sonarqube-db:5432/sonar
SONARQUBE_JDBC_USERNAME=sonar
SONARQUBE_JDBC_PASSWORD=sonar
POSTGRES_DB=sonar
POSTGRES_USER=sonar
POSTGRES_PASSWORD=sonar

# Ngrok (Get your token from https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=your-ngrok-authtoken