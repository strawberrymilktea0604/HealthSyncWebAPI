# .env.prod (Production)
# Template for production environment
# Copy this file to .env.prod and fill in the actual values
# ⚠️ SECURITY WARNING: Use strong, unique passwords in production!

ASPNETCORE_ENVIRONMENT=Production

# Database
SA_PASSWORD=your-strong-production-sa-password
ConnectionStrings__DefaultConnection=Server=db,1433;Database=HealthSyncProdDb;User Id=sa;Password=your-strong-production-sa-password;MultipleActiveResultSets=true;TrustServerCertificate=True
ConnectionStrings__HangfireConnection=Server=db,1433;Database=HealthSyncProdDb;User Id=sa;Password=your-strong-production-sa-password;MultipleActiveResultSets=true;TrustServerCertificate=True
ACCEPT_EULA=Y

# JWT thật (MUST be different from dev and at least 64 characters)
JWT_SECRET_KEY=your-production-jwt-secret-key-minimum-64-characters-highly-secure
JwtSettings__SecretKey=your-production-jwt-secret-key-minimum-64-characters-highly-secure
JwtSettings__Issuer=HealthSyncAPI
JwtSettings__Audience=HealthSyncClient

# MinIO thật
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=your-prod-minio-access-key
MINIO_SECRET_KEY=your-prod-minio-secret-key
MINIO_BUCKET_NAME=healthsync-prod-images
MinIO__Endpoint=minio:9000
MinIO__AccessKey=your-prod-minio-access-key
MinIO__SecretKey=your-prod-minio-secret-key
MinIO__BucketName=healthsync-prod-images
MinIO__UseSSL=false

# Admin Initialization (Use a strong random key)
ADMIN_INITIALIZATION_KEY=your-strong-admin-initialization-key

# Google OAuth (Production credentials)
Authentication__Google__ClientId=your-prod-google-client-id
Authentication__Google__ClientSecret=your-prod-google-client-secret

# NGINX
NGINX_PORT_HTTP=80
NGINX_PORT_HTTPS=443

# ========================================
# CLOUDFLARE QUICK TUNNEL
# ========================================
# Quick Tunnel KHÔNG CẦN tokens hay config gì cả!
# Chỉ cần chạy: docker-compose -f docker-compose.prod.yml up -d --build
# Lấy URLs: .\get-tunnel-urls.ps1 -Environment prod

# ========================================
# MINIO CONFIGURATION
# ========================================
# ✅ KHUYÊN DÙNG: API sẽ tự động dùng internal URLs (http://minio:9000)
# MinIO Server/Console URLs trong docker-compose.prod.yml đã được set thành:
#   MINIO_SERVER_URL=http://minio:9000
#   MINIO_BROWSER_REDIRECT_URL=http://minio:9001
#
# MinIO Console public URL (via Quick Tunnel) chỉ dùng khi bạn muốn 
# truy cập web UI từ browser bên ngoài. URL này thay đổi sau mỗi restart.
# Chạy: docker logs healthsync-tunnel-minio-console 2>&1 | Select-String "trycloudflare.com"