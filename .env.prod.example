# .env.prod.example (Template for Production)
# Copy this file to .env.prod and fill in the actual values

ASPNETCORE_ENVIRONMENT=Production

# Database
SA_PASSWORD=CHANGE_ME
ConnectionStrings__DefaultConnection=Server=db,1433;Database=HealthSyncProdDb;User Id=sa;Password=CHANGE_ME;MultipleActiveResultSets=true;TrustServerCertificate=TrueConnectionStrings__HangfireConnection=Server=db,1433;Database=HealthSyncDb;User Id=sa;Password=CHANGE_ME;Trusted_Connection=False;MultipleActiveResultSets=true;TrustServerCertificate=TrueACCEPT_EULA=Y

# JWT thật
JWT_SECRET_KEY=CHANGE_ME
JwtSettings__SecretKey=CHANGE_ME
JwtSettings__Issuer=HealthSyncAPI
JwtSettings__Audience=HealthSyncClient

# MinIO thật
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_NAME=healthsync-prod-images
MinIO__Endpoint=minio:9000
MinIO__AccessKey=CHANGE_ME
MinIO__SecretKey=CHANGE_ME
MinIO__BucketName=healthsync-prod-images
MinIO__UseSSL=false

# Admin Initialization
ADMIN_INITIALIZATION_KEY=CHANGE_ME

# Google OAuth
Authentication__Google__ClientId=CHANGE_ME
Authentication__Google__ClientSecret=CHANGE_ME

# NGINX
NGINX_PORT_HTTP=80
NGINX_PORT_HTTPS=443