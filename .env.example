# .env.example (Common / Defaults Template)
# Copy this file to `.env` and fill in your actual values
# NEVER commit `.env` to Git (already in .gitignore)

# ========================================
# APP INFO
# ========================================
# JWT Settings
JWT_ISSUER=HealthSyncAPI
JWT_AUDIENCE=HealthSyncClient
# Generate strong secret key: openssl rand -base64 64
JWT_SECRET_KEY=your-jwt-secret-key-minimum-32-characters-long-here

# ========================================
# THIRD PARTY (OAuth2)
# ========================================
# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ========================================
# STORAGE DEFAULTS
# ========================================
MINIO_BUCKET_NAME=healthsync-images
MINIO_USE_SSL=false

# ========================================
# ADMIN INITIALIZATION
# ========================================
# Generate strong key: openssl rand -base64 32
# This key is used ONLY ONCE to create the first admin account
ADMIN_INITIALIZATION_KEY=your-strong-admin-initialization-key-here
