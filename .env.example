# .env (Common / Defaults)
# Template for common environment variables shared across all environments
# Copy this file to .env and fill in the actual values
# NEVER commit .env to Git (already in .gitignore)

# --- APP INFO ---
JWT_ISSUER=HealthSyncAPI
JWT_AUDIENCE=HealthSyncClient
# Dùng chung 1 tên biến thống nhất
# Generate strong secret key: openssl rand -base64 64
JWT_SECRET_KEY=your-jwt-secret-key-minimum-32-characters-long

# --- THIRD PARTY (Giả sử Client ID giống nhau hoặc để trống chờ override) ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- STORAGE DEFAULTS ---
MINIO_BUCKET_NAME=healthsync-images
MINIO_USE_SSL=false

# --- ADMIN ---
# Generate strong key: openssl rand -base64 32
ADMIN_INITIALIZATION_KEY=your-admin-initialization-key
