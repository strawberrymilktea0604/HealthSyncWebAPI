# ========================================
# STAGE 1: Build và tạo EF Core Bundle
# ========================================
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Install EF Core tools
RUN dotnet tool install --global dotnet-ef --version 9.0.0
ENV PATH="${PATH}:/root/.dotnet/tools"

# Copy project files và restore
COPY ["HealthSync.WebApi/HealthSync.WebApi.csproj", "HealthSync.WebApi/"]
COPY ["HealthSync.Application/HealthSync.Application.csproj", "HealthSync.Application/"]
COPY ["HealthSync.Domain/HealthSync.Domain.csproj", "HealthSync.Domain/"]
COPY ["HealthSync.Infrastructure/HealthSync.Infrastructure.csproj", "HealthSync.Infrastructure/"]
RUN dotnet restore "HealthSync.WebApi/HealthSync.WebApi.csproj"

# Copy toàn bộ source code
COPY . .

# Build project
WORKDIR "/src/HealthSync.WebApi"
RUN dotnet build "HealthSync.WebApi.csproj" -c Release -o /app/build

# Publish application
RUN dotnet publish "HealthSync.WebApi.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Set environment variables for EF bundle creation
ENV JWT_SECRET_KEY="dummy-key-for-migration-bundle-at-least-32-characters-long-1234567890"
ENV ConnectionStrings__DefaultConnection="Server=dummy;Database=dummy;Trusted_Connection=True;"

# Tạo EF Core Migration Bundle (standalone executable)
WORKDIR "/src/HealthSync.Infrastructure"
RUN dotnet ef migrations bundle \
    --startup-project ../HealthSync.WebApi/HealthSync.WebApi.csproj \
    --project HealthSync.Infrastructure.csproj \
    --configuration Release \
    --output /app/efbundle \
    --self-contained \
    --force

# ========================================
# STAGE 2: Runtime - chỉ chạy migrations
# ========================================
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

# Install dependencies cho wait script
RUN apt-get update && apt-get install -y --no-install-recommends \
    netcat-openbsd \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy EF Bundle từ build stage
COPY --from=build /app/efbundle /app/efbundle

# Copy migration script
COPY migrate.sh /app/migrate.sh
RUN chmod +x /app/migrate.sh

# Switch to non-root user for security
USER app

# Set entrypoint
ENTRYPOINT ["/app/migrate.sh"]