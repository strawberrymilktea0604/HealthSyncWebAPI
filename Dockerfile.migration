# ========================================
# STAGE 1: Build và tạo EF Core Bundle
# ========================================
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Install EF Core tools
RUN dotnet tool install --global dotnet-ef --version 9.0.0
ENV PATH="${PATH}:/root/.dotnet/tools"

# Copy project files và restore
COPY ["HealthSync.WebApi/HealthSync.WebApi.csproj", "HealthSync.WebApi/"]
COPY ["HealthSync.Application/HealthSync.Application.csproj", "HealthSync.Application/"]
COPY ["HealthSync.Domain/HealthSync.Domain.csproj", "HealthSync.Domain/"]
COPY ["HealthSync.Infrastructure/HealthSync.Infrastructure.csproj", "HealthSync.Infrastructure/"]
RUN dotnet restore "HealthSync.WebApi/HealthSync.WebApi.csproj"

# Copy toàn bộ source code
COPY . .

# Build project
WORKDIR "/src/HealthSync.WebApi"
RUN dotnet build "HealthSync.WebApi.csproj" -c Release -o /app/build

# Publish application
RUN dotnet publish "HealthSync.WebApi.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Tạo EF Core Migration Bundle (standalone executable)
WORKDIR "/src/HealthSync.Infrastructure"
RUN dotnet ef migrations bundle \
    --startup-project ../HealthSync.WebApi/HealthSync.WebApi.csproj \
    --project HealthSync.Infrastructure.csproj \
    --configuration Release \
    --output /app/efbundle \
    --self-contained \
    --force

# ========================================
# STAGE 2: Runtime - chỉ chạy migrations
# ========================================
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

# Install dependencies cho wait script
RUN apt-get update && apt-get install -y --no-install-recommends \
    netcat-openbsd \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy EF Bundle từ build stage
COPY --from=build /app/efbundle /app/efbundle

# Create migration script
RUN echo '#!/bin/bash\nset -e\n\necho "=========================================="\necho "HealthSync Migration Init Container"\necho "=========================================="\n\n# Extract DB host from connection string\nDB_HOST=$(echo "$ConnectionStrings__DefaultConnection" | grep -oP '\''(?<=Server=)[^;]+'\'' || echo "db")\nDB_PORT=1433\n\necho "Waiting for SQL Server at ${DB_HOST}:${DB_PORT}..."\n\n# Wait for database (max 120 seconds - increased for slow servers)\nMAX_RETRIES=120\nRETRY_COUNT=0\n\nwhile [ $RETRY_COUNT -lt $MAX_RETRIES ]; do\n    if nc -z -w 3 "$DB_HOST" "$DB_PORT" 2>/dev/null; then\n        echo "✓ SQL Server is ready!"\n        break\n    fi\n    \n    RETRY_COUNT=$((RETRY_COUNT + 1))\n    echo "Waiting... (attempt $RETRY_COUNT/$MAX_RETRIES)"\n    sleep 2\ndone\n\nif [ $RETRY_COUNT -eq $MAX_RETRIES ]; then\n    echo "✗ ERROR: SQL Server not ready after ${MAX_RETRIES} attempts"\n    exit 1\nfi\n\necho ""\necho "Running EF Core migrations..."\necho "Connection: ${ConnectionStrings__DefaultConnection}"\necho ""\n\n# Execute EF Core Bundle\n/app/efbundle --connection "$ConnectionStrings__DefaultConnection" --verbose\n\nif [ $? -eq 0 ]; then\n    echo ""\n    echo "=========================================="\n    echo "✓ Migrations completed successfully!"\n    echo "=========================================="\n    exit 0\nelse\n    echo ""\n    echo "=========================================="\n    echo "✗ Migration failed!"\n    echo "=========================================="\n    exit 1\nfi' > /app/migrate.sh

RUN chmod +x /app/migrate.sh

# Switch to non-root user for security
USER app

# Set entrypoint
ENTRYPOINT ["/app/migrate.sh"]