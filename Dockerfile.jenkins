FROM jenkins/jenkins:lts-alpine

USER root

# Install dependencies for .NET
RUN apk update && \
    apk add --no-cache \
        wget \
        icu-libs \
        krb5-libs \
        libgcc \
        libintl \
        libssl3 \
        libstdc++ \
        zlib \
        docker-cli

# Download and install .NET 8.0 SDK
RUN wget https://dotnetcli.azureedge.net/dotnet/Sdk/8.0.405/dotnet-sdk-8.0.405-linux-musl-x64.tar.gz -O dotnet.tar.gz && \
    mkdir -p /usr/share/dotnet && \
    tar -zxf dotnet.tar.gz -C /usr/share/dotnet && \
    rm dotnet.tar.gz

# Add .NET to PATH
ENV PATH="$PATH:/usr/share/dotnet"

# Install SonarScanner CLI
RUN wget https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/sonar-scanner-cli-5.0.1.3006-linux.zip -O sonar-scanner.zip && \
    unzip sonar-scanner.zip && \
    mv sonar-scanner-5.0.1.3006-linux /opt/sonar-scanner && \
    rm sonar-scanner.zip

ENV PATH="$PATH:/opt/sonar-scanner/bin"

# Switch back to jenkins user
USER jenkins

# Install dotnet-sonarscanner as jenkins user
RUN dotnet tool install --global dotnet-sonarscanner --version 5.14.0